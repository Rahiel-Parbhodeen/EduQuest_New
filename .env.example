NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/eduquest?sslmode=disable
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/eduquest_test?sslmode=disable
PGLITE_DEV_PORT=5432
PGLITE_TEST_PORT=5433
COOKIE_SECURE=false
UPLOAD_MAX_BYTES=52428800
AI_SERVICE_URL=http://localhost:8000
# npm run setup:token generates AI_SERVICE_TOKEN automatically.
AI_MAX_BODY_BYTES=8388608
AI_REQUEST_TIMEOUT_SECONDS=300
AI_TIMEOUT_SECONDS=120
DOCUMENT_MAX_TEXT_CHARS=500000
DOCUMENT_MAX_EXPANDED_BYTES=209715200
DOCUMENT_MAX_PDF_PAGES=1000
DOCUMENT_MAX_ARCHIVE_ENTRIES=10000
SEED_LECTURER_EMAIL=lecturer@example.com
SEED_LECTURER_NAME=Demo Lecturer
# Supply a precomputed argon2id/bcrypt hash; never put a plaintext password here.
SEED_LECTURER_PASSWORD_HASH=

AI_PROVIDER=mock
# For live generation set AI_PROVIDER=gemini, anthropic, openai or openai_compatible.
AI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_BASE_URL=
AI_API_KEY=
# PYTHON_COMMAND may override automatic .venv detection.
